# Скопіюйте у .env.local (він у .gitignore) і заповніть значеннями з проєкту Supabase команди (одна база на команду):
# Project Settings → API Keys. Значення ніколи не комітимо й не вставляємо в чат з агентом.

# Публічні (потрапляють у браузер):
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Секретний ключ (обходить RLS!). Ніколи з префіксом NEXT_PUBLIC_. Потрібен npm run users:demo і, з WS7, запрошенням
# (src/lib/supabase/admin.ts — єдиний модуль, що його читає). У Vercel — лише Production, не Preview (ADR 0003):
SUPABASE_SECRET_KEY=sb_secret_...

# Спільний пароль синтетичних користувачів для npm run users:demo (≥ 8 символів):
DEMO_USER_PASSWORD=

# Для Supabase MCP у Claude Code (.mcp.json читає змінну з оточення, а не з цього файлу):
# задайте її в терміналі перед запуском claude, напр. export SUPABASE_PROJECT_REF=<project-ref>
# SUPABASE_PROJECT_REF=

# WS10: помічник «Скласти чернетку» (ADR 0004). Ключ OpenRouter — власний, безкоштовний, зі свого акаунта, не спільний
# на команду (openrouter.ai → Keys); ніколи з префіксом NEXT_PUBLIC_. Читає лише src/lib/request-draft/openrouter.ts.
# Порожньо — помічник «недоступний», ручна форма працює (AC-DRAFT-06); npm run build і npm test ключа не потребують.
OPENROUTER_API_KEY=
# Необов'язково: модель, яку пробувати першою, — лише id з «:free» (інше ігнорується); далі — ланцюжок FREE_MODELS
# з src/lib/request-draft/models.ts. Напр. OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_MODEL=
